## Example environment for docker-compose.front.yml
# Replace values and save as .env.front

# Docker images (push built images to your registry)
FRONT_IMAGE=your-registry/avxm_front:latest
CHAT_FRONT_IMAGE=your-registry/avxm_chat_front:latest

# Backend URL used by frontend (must match deployed backend)
VITE_BASE_URL=https://back.avxm.live
